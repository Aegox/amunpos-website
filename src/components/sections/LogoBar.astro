---
const brands = ["/brand_1.svg", "/brand_2.svg", "/brand_3.svg", "/brand_4.svg", "/brand_5.svg", "/brand_6.svg"];
---

<section class="w-full border-y border-stroke-soft-200 bg-weak-50/60 px-5 py-12">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <h2 class="text-label-xs uppercase tracking-[0.08em] text-soft-400">
      Negocios que ya confían en AmunPOS
    </h2>
    <ul class="mt-8 flex w-full flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {brands.map((src) => (
        <li>
          <img
            src={src}
            alt="Marca aliada de AmunPOS"
            width="130"
            height="40"
            class="h-8 w-auto opacity-50 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
