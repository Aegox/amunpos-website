---
import { RiSparklingLine, RiPulseLine, RiRocket2Line } from "@remixicon/react";

const items = [
  {
    icon: RiSparklingLine,
    title: "IA en cada paso",
    desc: "Un asistente que responde, migra tu inventario y lee facturas por ti.",
    color: "text-ai-base",
    delay: "0s",
  },
  {
    icon: RiPulseLine,
    title: "Todo en un solo panel",
    desc: "Ventas, inventario, nómina y reportes, siempre sincronizados.",
    color: "text-primary-base",
    delay: "0.15s",
  },
  {
    icon: RiRocket2Line,
    title: "Crece sin fricción",
    desc: "Suma sucursales y empleados sin cambiar de sistema.",
    color: "text-gray-800",
    delay: "0.3s",
  },
];
---

<div class="w-full px-5">
  <!-- Conector decorativo: mismo recurso visual que la tira de beneficios
       real de alignui.com bajo su hero (tres ramas curvas + puntos) -->
  <div class="hidden justify-center py-3.5 xl:flex">
    <div class="relative w-fit">
      <div class="absolute left-1/2 top-0 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gray-200"></div>
      <div class="absolute bottom-0 left-0 size-1.5 -translate-x-0.5 translate-y-1/2 rounded-full bg-gray-200"></div>
      <div class="absolute bottom-0 left-1/2 size-1.5 -translate-x-1/2 translate-y-1/2 rounded-full bg-gray-200"></div>
      <div class="absolute bottom-0 right-0 size-1.5 translate-x-1/2 translate-y-1/2 rounded-full bg-gray-200"></div>
      <svg width="701" height="48" viewBox="0 0 701 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 48V40C1 31.1634 8.16344 24 17 24H335C343.837 24 351 16.8366 351 8V0" class="stroke-gray-200" stroke-width="1"></path>
        <path d="M350 32L350 48" class="stroke-gray-200" stroke-width="1"></path>
        <path d="M700 48V40C700 31.1634 692.837 24 684 24H366C357.163 24 350 16.8366 350 8V0" class="stroke-gray-200" stroke-width="1"></path>
      </svg>
    </div>
  </div>

  <div class="mx-auto flex max-w-[1240px] flex-col gap-6 md:flex-row md:justify-center xl:mt-[22px] xl:gap-20">
    {
      items.map(({ icon: Icon, title, desc, color, delay }, i) => (
        <>
          <div
            class="animate-fade-up flex flex-row gap-4 md:flex-col md:items-center md:gap-0 md:text-center xl:w-[270px]"
            style={{ animationDelay: delay }}
          >
            <Icon className={`size-6 shrink-0 ${color}`} />
            <div class="md:mt-4">
              <div class="text-label-md text-gray-800">{title}</div>
              <div class="mt-1 text-paragraph-md text-gray-600 md:text-paragraph-sm">{desc}</div>
            </div>
          </div>
          {i < items.length - 1 && (
            <div
              class="h-px w-full text-gray-300 md:hidden"
              style={{ background: "linear-gradient(90deg, currentcolor 4px, transparent 4px) 50% 50% / 8px 1px repeat-x" }}
            />
          )}
        </>
      ))
    }
  </div>
</div>
