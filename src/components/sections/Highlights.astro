---
import { RiSparklingLine, RiPulseLine, RiRocket2Line } from "@remixicon/react";

const props = [
  {
    icon: RiSparklingLine,
    title: "IA en cada paso",
    desc: "Un asistente que responde, migra tu inventario y lee facturas por ti.",
    color: "text-ai-base",
  },
  {
    icon: RiPulseLine,
    title: "Todo en un solo panel",
    desc: "Ventas, inventario, nómina y reportes, siempre sincronizados.",
    color: "text-primary-base",
  },
  {
    icon: RiRocket2Line,
    title: "Crece sin fricción",
    desc: "Suma sucursales y empleados sin cambiar de sistema.",
    color: "text-gray-800",
  },
];
---

<section class="w-full px-5 pt-10 pb-14 xl:pt-14 xl:pb-20">
  <div class="mx-auto max-w-[1080px]">
    <!-- Showcase del producto: captura real del panel, enmarcada con "chrome"
         de navegador y un glow azul de marca detrás. -->
    <div class="relative" data-reveal>
      <div class="pointer-events-none absolute -inset-x-8 -top-6 bottom-6 rounded-[48px] bg-primary-base/10 blur-[90px]"></div>
      <div class="relative overflow-hidden rounded-2xl border border-gray-200 bg-gray-0 shadow-[0_28px_70px_-24px_rgba(16,24,40,0.28)]">
        <div class="flex items-center gap-1.5 border-b border-gray-200 bg-gray-50 px-4 py-3">
          <span class="size-2.5 rounded-full bg-gray-300"></span>
          <span class="size-2.5 rounded-full bg-gray-300"></span>
          <span class="size-2.5 rounded-full bg-gray-300"></span>
          <span class="ml-3 hidden rounded-md bg-gray-0 px-2.5 py-1 text-paragraph-xs text-gray-450 ring-1 ring-gray-200 sm:inline">
            app.amunpos.com
          </span>
        </div>
        <img
          src="/capture-of-pos.webp"
          width="1679"
          height="918"
          alt="Panel de AmunPOS: ventas, inventario y reportes en un solo lugar"
          class="h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Propuestas de valor, como soporte del visual -->
    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 xl:mt-16">
      {
        props.map(({ icon: Icon, title, desc, color }, i) => (
          <div
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
            class="flex flex-col items-center text-center md:items-start md:text-left"
          >
            <div class="flex size-11 items-center justify-center rounded-[10px] bg-gray-50 ring-1 ring-inset ring-gray-100">
              <Icon className={`size-5 ${color}`} />
            </div>
            <h3 class="mt-4 text-label-lg text-gray-900">{title}</h3>
            <p class="mt-1.5 max-w-[300px] text-paragraph-sm text-gray-600">{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
