---
import { RiSparklingLine, RiArrowRightUpLine, RiCheckLine } from "@remixicon/react";

const roadmapItems = [
  "Sugerencia de compras según tu velocidad de venta real",
  "Publicaciones de marketing con la identidad de tu marca",
];
---

<section id="IA" class="relative w-full scroll-mt-[72px] overflow-hidden bg-strong-950 px-5 py-20 lg:py-28">
  <div class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-feature-base/20 blur-[140px]"></div>

  <div class="relative mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-feature-base/30 bg-white/5 px-3 py-1.5 text-label-sm text-feature-light">
      <RiSparklingLine className="size-3.5" />
      Impulsado por IA
    </span>
    <h2 class="mt-5 max-w-2xl text-center text-title-h3 text-white lg:text-title-h2">
      La IA que hace el trabajo, no la que promete magia
    </h2>
    <p class="mt-4 max-w-xl text-center text-paragraph-md text-white/60">
      Cuatro tareas que antes te robaban horas — migrar datos, leer facturas, armar
      horarios y entender tus números — ahora las resuelve la IA de AmunPOS mientras tú
      atiendes el negocio.
    </p>

    <!-- Row 1: Asistente de negocio — chat mockup -->
    <div class="mt-20 flex w-full flex-col items-center gap-10 lg:flex-row lg:gap-16">
      <div class="w-full lg:w-1/2">
        <span class="text-subheading-xs uppercase text-feature-light">Asistente 24/7</span>
        <h3 class="mt-3 text-title-h5 text-white">Pregúntale a tu negocio, como si hablaras con un socio</h3>
        <p class="mt-3 text-paragraph-md text-white/60">
          Pregunta en lenguaje natural: "¿cuál fue mi producto más vendido esta semana?" y
          obtén la respuesta al instante, sin abrir un reporte.
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm">
          <div class="flex items-center gap-2 border-b border-white/10 pb-3">
            <span class="flex size-6 items-center justify-center rounded-full bg-feature-base/20 text-feature-light">
              <RiSparklingLine className="size-3.5" />
            </span>
            <span class="text-label-sm text-white">Asistente AmunPOS</span>
          </div>
          <div class="mt-4 flex flex-col gap-3">
            <div class="ml-auto max-w-[80%] rounded-xl rounded-tr-sm bg-white/10 px-4 py-2.5 text-paragraph-sm text-white">
              ¿Cuál fue mi producto más vendido esta semana?
            </div>
            <div class="max-w-[85%] rounded-xl rounded-tl-sm border border-feature-base/20 bg-feature-base/10 px-4 py-2.5 text-paragraph-sm text-white/90">
              "Café Americano 12oz" — 214 unidades, 18% más que la semana pasada.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2: Migración — upload mockup -->
    <div class="mt-16 flex w-full flex-col items-center gap-10 lg:flex-row-reverse lg:gap-16">
      <div class="w-full lg:w-1/2">
        <span class="text-subheading-xs uppercase text-feature-light">Migración sin planillas</span>
        <h3 class="mt-3 text-title-h5 text-white">Sube tu inventario tal cual está — nosotros lo acomodamos</h3>
        <p class="mt-3 text-paragraph-md text-white/60">
          Excel, PDF o hasta una foto de tu catálogo actual. La IA lo organiza dentro de
          AmunPOS por ti, sin planillas nuevas que llenar a mano.
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm">
          <div class="flex items-center justify-between rounded-xl border border-dashed border-white/15 bg-white/[0.03] px-4 py-3">
            <span class="text-paragraph-sm text-white/80">catalogo-productos.xlsx</span>
            <span class="flex size-5 items-center justify-center rounded-full bg-feature-base text-white">
              <RiCheckLine className="size-3.5" />
            </span>
          </div>
          <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
            <div class="h-full w-[86%] rounded-full bg-feature-base"></div>
          </div>
          <p class="mt-3 text-paragraph-xs text-white/40">312 productos importados y clasificados automáticamente.</p>
        </div>
      </div>
    </div>

    <!-- Row 3: Facturas — extraction mockup -->
    <div class="mt-16 flex w-full flex-col items-center gap-10 lg:flex-row lg:gap-16">
      <div class="w-full lg:w-1/2">
        <span class="text-subheading-xs uppercase text-feature-light">Facturas que se leen solas</span>
        <h3 class="mt-3 text-title-h5 text-white">Fotografía una factura, olvídate de digitarla</h3>
        <p class="mt-3 text-paragraph-md text-white/60">
          Fotografía la factura de tu proveedor y la IA extrae productos, cantidades y
          precios listos para registrar en tu inventario.
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm">
          <div class="flex flex-col gap-2 text-paragraph-sm text-white/80">
            <div class="flex items-center justify-between border-b border-white/10 pb-2">
              <span>Harina de trigo 25kg</span>
              <span class="text-white/50">x4 · $62.00</span>
            </div>
            <div class="flex items-center justify-between border-b border-white/10 pb-2">
              <span>Aceite vegetal 5L</span>
              <span class="text-white/50">x6 · $54.00</span>
            </div>
            <div class="flex items-center justify-between">
              <span>Azúcar refinada 50kg</span>
              <span class="text-white/50">x2 · $38.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 4: Horarios — schedule mockup -->
    <div class="mt-16 flex w-full flex-col items-center gap-10 lg:flex-row-reverse lg:gap-16">
      <div class="w-full lg:w-1/2">
        <span class="text-subheading-xs uppercase text-feature-light">Horarios en minutos</span>
        <h3 class="mt-3 text-title-h5 text-white">Describe turnos, la IA arma el horario</h3>
        <p class="mt-3 text-paragraph-md text-white/60">
          Describe disponibilidad y turnos; la IA arma el horario semanal de tu equipo y lo
          ajusta automáticamente cuando algo cambia.
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm">
          <div class="grid grid-cols-5 gap-2 text-center text-paragraph-xs text-white/50">
            <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span>
          </div>
          <div class="mt-2 grid grid-cols-5 gap-2">
            {[1, 0, 1, 1, 0].map((filled) => (
              <div class={`h-16 rounded-lg ${filled ? "bg-feature-base/25 border border-feature-base/40" : "bg-white/5"}`}></div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Roadmap -->
    <div class="mt-16 flex w-full flex-col items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:flex-row sm:justify-between">
      <div class="flex flex-col gap-2 text-center sm:text-left">
        <span class="inline-flex w-fit items-center rounded-full bg-feature-lighter px-2 text-subheading-2xs uppercase text-feature-base mx-auto sm:mx-0">
          Próximamente
        </span>
        <ul class="flex flex-col gap-1 text-paragraph-sm text-white/50">
          {roadmapItems.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
      <a
        href="#Contacto"
        class="flex shrink-0 items-center gap-1.5 text-label-sm font-medium text-feature-light transition-colors duration-200 hover:text-white"
      >
        Cuéntanos qué necesitas
        <RiArrowRightUpLine className="size-4" />
      </a>
    </div>
  </div>
</section>
