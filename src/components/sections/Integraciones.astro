---
import {
  RiPlugLine,
  RiMotorbikeLine,
  RiEBike2Line,
  RiTakeawayLine,
  RiHandbagLine,
  RiRestaurantLine,
  RiBankCardLine,
  RiSmartphoneLine,
  RiQrCodeLine,
  RiWallet3Line,
  RiFileExcel2Line,
  RiStore2Line,
  RiTerminalBoxLine,
  RiBook2Line,
} from "@remixicon/react";
import Regla from "./Regla.astro";

/**
 * "Se lleva con lo que ya usas".
 *
 * Quita de un plumazo la objeción más común de quien ya tiene el negocio
 * andando: "¿tengo que dejar de usar Rappi?". La respuesta es no, y decirlo
 * pronto vale más que cualquier función.
 *
 * SIN LOGOS DE MARCA, a propósito, y esto conviene entenderlo antes de
 * cambiarlo. En el repo del POS hay imágenes con nombre de marca
 * (didi-food-orange-logo.jpg y compañía) que NO son las marcas: son
 * ilustraciones genéricas generadas. Y ninguna librería de iconos trae los
 * logos de Rappi, DiDi, Bold o Nequi — son marcas latinoamericanas. Dibujarlos
 * a mano sería inventar un logo ajeno, que es exactamente el problema que se
 * evitó al descartar aquellas imágenes.
 *
 * Así que cada marca lleva un icono GENÉRICO —de qué tipo de cosa es— más su
 * nombre. El icono da el golpe de vista y hace la fila mucho más fácil de
 * barrer; el nombre es lo que de verdad identifica. Un icono suelto de una moto
 * no dice "Rappi", dice "domicilios", y entonces la sección deja de responder a
 * la pregunta que venía a responder.
 */
const grupos = [
  {
    titulo: "Domicilios",
    marcas: [
      { nombre: "Rappi", icon: RiMotorbikeLine },
      { nombre: "DiDi Food", icon: RiEBike2Line },
      { nombre: "Uber Eats", icon: RiTakeawayLine },
      { nombre: "Glovo", icon: RiHandbagLine },
      { nombre: "PedidosYa", icon: RiRestaurantLine },
    ],
  },
  {
    titulo: "Cobros y datáfonos",
    marcas: [
      { nombre: "Bold", icon: RiBankCardLine },
      { nombre: "Nequi", icon: RiSmartphoneLine },
      { nombre: "Daviplata", icon: RiSmartphoneLine },
      { nombre: "Wompi", icon: RiQrCodeLine },
      { nombre: "Mercado Pago", icon: RiWallet3Line },
    ],
  },
  {
    titulo: "De dónde vienes",
    marcas: [
      { nombre: "Excel", icon: RiFileExcel2Line },
      { nombre: "Loyverse", icon: RiStore2Line },
      { nombre: "Square", icon: RiTerminalBoxLine },
      { nombre: "Clover", icon: RiStore2Line },
      { nombre: "Cuaderno", icon: RiBook2Line },
    ],
  },
];
---

<section id="Integraciones" class="w-full py-16 xl:py-20">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center px-5">
    <span
      data-reveal
      class="flex h-8 items-center gap-1.5 rounded-9 bg-gray-0 pl-2 pr-3 text-label-sm text-gray-700 shadow-button-white"
    >
      <RiPlugLine className="size-4 text-gray-400" />
      Integraciones
    </span>
    <h2 data-reveal style="--reveal-delay: 60ms" class="mt-4 text-balance text-center text-title-h4 text-gray-900">
      No tienes que dejar nada.
    </h2>
    <p
      data-reveal
      style="--reveal-delay: 120ms"
      class="mt-3 max-w-xl text-pretty text-center text-paragraph-md text-gray-600"
    >
      amunpos se lleva con lo que ya tienes montado. Sigues cobrando y
      repartiendo igual; lo que cambia es que todo entra al mismo sitio.
    </p>
  </div>

  <Regla class="mt-12" />

  <div class="mx-auto grid w-full max-w-[1240px] grid-cols-1 px-5 md:grid-cols-3">
    {
      grupos.map((g, i) => (
        <div class="relative flex flex-col py-8 md:px-8 md:py-10">
          {i > 0 && <span aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-px bg-gray-200 md:block" />}
          <div class="text-label-sm text-gray-900">{g.titulo}</div>
          {/* Cada nombre entra con su retardo: la fila se va llenando en vez de
              aparecer de golpe, que es lo que la hace agradable de mirar. */}
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.marcas.map((m, j) => (
              <li
                data-reveal
                style={`--reveal-delay: ${i * 90 + j * 60}ms`}
                class="group flex h-9 items-center gap-2 rounded-9 bg-gray-0 pl-2.5 pr-3 text-label-sm text-gray-700 shadow-button-white transition duration-200 hover:text-gray-900"
              >
                <m.icon className="size-4 shrink-0 text-gray-400 transition-colors duration-200 group-hover:text-primary-base" />
                {m.nombre}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <Regla />

  <div class="mx-auto flex w-full max-w-[1240px] justify-center px-5">
    <p class="mt-6 max-w-xl text-pretty text-center text-paragraph-xs text-gray-450">
      Los iconos son ilustrativos, no logotipos. Marcas de sus respectivos
      dueños, citadas solo para describir compatibilidad. ¿Usas algo que no
      está? Escríbenos y lo miramos.
    </p>
  </div>
</section>
