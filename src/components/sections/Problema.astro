---
import {
  RiCalculatorLine,
  RiFileExcel2Line,
  RiWhatsappLine,
  RiMotorbikeLine,
  RiCalendar2Line,
  RiArchiveDrawerLine,
  RiErrorWarningLine,
  RiCheckLine,
} from "@remixicon/react";
import Regla from "./Regla.astro";

/**
 * El problema: la lámina 2 del deck, lo primero que dice el guion del pitch —
 * "media docena de herramientas que no se hablan entre sí".
 *
 * Va DESPUÉS del selector de producto. Delante, la página abría en tono de
 * queja y tardaba en enseñar nada; detrás, el visitante ya ha visto de qué se
 * trata y la lista de trastos funciona como "y esto es lo que te quita de
 * encima".
 *
 * Antes cada trasto se tachaba en bucle y los iconos volaban hacia un logo. Era
 * vistoso, pero en casi cualquier momento se leía a medio tachar, el logo pasaba
 * la mitad del ciclo invisible dejando un hueco, y solo decía qué se quita. Ahora
 * cada fila dice las dos cosas, quieta y completa: lo que duele hoy y lo que queda.
 *
 * `queda` debe ser cierto hoy: nada de lo que está marcado "Próximamente".
 */
const trastos = [
  { icon: RiCalculatorLine, nombre: "El POS o el cuaderno", pega: "La venta queda anotada y ahí se acaba.", queda: "Cada venta mueve caja e inventario" },
  { icon: RiFileExcel2Line, nombre: "El Excel del inventario", pega: "Nunca cuadra con lo que hay en la bodega.", queda: "Stock al día con cada venta" },
  { icon: RiWhatsappLine, logo: "whatsapp", nombre: "Los pedidos por WhatsApp", pega: "Se pierden entre mensajes y fotos.", queda: "Domicilios con estado y repartidor" },
  { icon: RiMotorbikeLine, nombre: "La app de domicilios", pega: "Hasta un 30 % de comisión por cada pedido.", queda: "Delivery propio, sin comisión por pedido" },
  { icon: RiCalendar2Line, nombre: "La nómina a mano", pega: "Horas contadas de memoria a fin de mes.", queda: "Fichaje, horarios y pagos" },
  { icon: RiArchiveDrawerLine, nombre: "La caja en papel", pega: "El arqueo no cuadra y nadie sabe por qué.", queda: "Cierre con esperado, contado y diferencia" },
];
---

<section id="Problema" class="w-full py-12 xl:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center px-5">
    <span
      data-reveal
      class="flex h-8 items-center gap-1.5 rounded-9 bg-gray-0 pl-2 pr-3 text-label-sm text-gray-700 shadow-button-white"
    >
      <RiErrorWarningLine className="size-4 text-gray-400" />
      El problema
    </span>

    <h2
      data-reveal
      style="--reveal-delay: 60ms"
      class="mt-4 text-balance text-center text-title-h4 text-gray-900 xl:text-title-h3"
    >
      Tu negocio vive en seis sitios a la vez.
    </h2>
    <p
      data-reveal
      style="--reveal-delay: 120ms"
      class="mt-3 max-w-xl text-pretty text-center text-paragraph-md text-gray-600"
    >
      Y ninguno se habla con el de al lado. Cada uno con su clave, su factura y
      su manera de fallar.
    </p>
  </div>

  <Regla class="mt-8 xl:mt-14" />

  <div class="relative mx-auto grid w-full max-w-[1240px] grid-cols-1 divide-y divide-gray-200 px-5 md:grid-cols-2 md:divide-y-0 xl:grid-cols-3">
    <!-- Las lineas de la reticula van absolutas sobre la rejilla entera, no
         como borde de cada celda: puestas por celda, la primera columna se
         quedaba con una raya suelta a la izquierda. Sin `gap`, las columnas
         caen exactamente en los tercios, asi que aqui no hace falta el
         desfase de 4 px que si necesita la seccion oscura. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px bg-gray-200 md:block xl:hidden"></div>
    {[1, 2].map((n) => (
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 hidden w-px bg-gray-200 xl:block"
        style={`left: ${(n / 3) * 100}%`}
      />
    ))}
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-5 top-1/2 hidden h-px bg-gray-200 xl:block"></div>
    {
      trastos.map((t, i) => {
        const Icon = t.icon;
        return (
          <div
            data-reveal
            style={`--reveal-delay: ${i * 50}ms`}
            class="flex gap-3.5 py-4 md:flex-col md:gap-0 md:px-8 md:py-7 xl:py-9"
          >
            <span class="flex size-6 shrink-0 items-center justify-center text-gray-400">
              {t.logo ? (
                <img src={`/marcas/${t.logo}.svg`} alt="" width="24" height="24" class="size-6 opacity-60" loading="lazy" />
              ) : (
                <Icon className="size-6" />
              )}
            </span>

            <div class="min-w-0 md:mt-5">
              <h3 class="text-label-md text-gray-900 md:text-label-lg">{t.nombre}</h3>
              <p class="mt-1 max-w-[42ch] text-pretty text-paragraph-sm text-gray-600 md:mt-2">{t.pega}</p>
              <p class="mt-2 flex items-start gap-1.5 text-label-sm text-gray-900 md:mt-3">
                <RiCheckLine className="mt-px size-4 shrink-0 text-primary-base" />
                {t.queda}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>

  <Regla />

  <div data-reveal class="mx-auto mt-8 flex w-full max-w-[1240px] flex-col items-center gap-3 px-5 xl:mt-12">
    <img src="/logo.png" alt="amunpos" class="h-7 w-auto xl:h-8" />
    <p class="text-balance text-center text-title-h6 text-gray-900 md:text-title-h5">
      Uno solo, y todo cuadra.
    </p>
  </div>
</section>
