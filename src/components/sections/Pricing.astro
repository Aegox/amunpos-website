---
import { RiPriceTag3Line, RiCheckLine } from "@remixicon/react";

const plans = [
  {
    title: "Básico",
    target: "Para pequeños negocios",
    price: "$24",
    popular: false,
    features: ["Hasta 1 usuario", "Gestión de inventario", "Informes y análisis de ventas", "Escaneo de código de barras", "Asistente IA incluido", "Soporte 24/7"],
  },
  {
    title: "Estándar",
    target: "Para profesionales",
    price: "$50",
    popular: true,
    features: ["Hasta 3 usuarios", "Gestión de inventario multi-sucursal", "Migración y facturación con IA", "Informes y análisis de ventas", "Escaneo de código de barras", "Soporte 24/7 prioritario"],
  },
  {
    title: "Profesional",
    target: "Para grandes empresas",
    price: "$85",
    popular: false,
    features: ["Usuarios ilimitados", "Gestión de inventario multi-sucursal", "Todas las funciones de IA", "Informes y análisis avanzados", "Escaneo de código de barras", "Soporte 24/7 dedicado"],
  },
];
---

<section id="Planes" class="relative w-full scroll-mt-[72px] bg-weak-50 px-5 py-20 lg:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-brand-50 px-3 py-1.5 text-label-sm text-primary-dark">
      <RiPriceTag3Line className="size-3.5" />
      Nuestros precios
    </span>
    <h2 class="mt-5 max-w-xl text-center text-title-h3 text-strong-950 lg:text-title-h2">
      Planes transparentes, la IA incluida en todos
    </h2>
    <p class="mt-4 max-w-lg text-center text-paragraph-md text-sub-600">
      Sin costos ocultos ni complementos sorpresa: elige según el tamaño de tu equipo.
    </p>

    <div class="mt-16 flex w-full flex-col items-center gap-8 xl:flex-row xl:items-stretch xl:gap-6">
      {plans.map((plan) => (
        <article
          class={`relative flex w-full flex-col rounded-2xl p-8 transition-shadow duration-300 md:w-[80%] xl:w-1/3 ${
            plan.popular
              ? "border-2 border-primary-base bg-white-0 shadow-[0_24px_48px_-16px_hsl(204_88%_40%/0.35)] xl:-translate-y-3"
              : "border border-stroke-soft-200 bg-white-0 shadow-regular-xs"
          }`}
        >
          {plan.popular && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary-base px-3 py-1 text-label-xs text-static-white shadow-regular-xs">
              Más popular
            </span>
          )}
          <h3 class="text-title-h6 text-strong-950">{plan.title}</h3>
          <p class="mt-1 text-paragraph-sm text-sub-600">{plan.target}</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-title-h3 text-strong-950">{plan.price}</span>
            <span class="text-paragraph-sm text-sub-600">/ mes</span>
          </div>

          <a
            href="#Contacto"
            class={`mt-6 flex h-11 w-full items-center justify-center rounded-10 text-label-sm transition duration-200 ${
              plan.popular
                ? "bg-primary-base text-static-white hover:bg-primary-darker"
                : "bg-white-0 text-strong-950 shadow-regular-xs ring-1 ring-inset ring-stroke-soft-200 hover:bg-weak-50"
            }`}
          >
            Escoger plan
          </a>

          <div class="my-7 h-px w-full bg-stroke-soft-200"></div>

          <ul class="flex flex-col gap-3.5">
            {plan.features.map((item) => (
              <li class="flex items-center gap-3 text-paragraph-sm text-sub-600">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-primary-base">
                  <RiCheckLine className="size-3" />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
