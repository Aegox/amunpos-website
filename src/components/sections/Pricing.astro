---
import { RiPriceTag3Line, RiInformationLine } from "@remixicon/react";
import PricingTable from "./PricingTable";
---

<section id="Planes" class="relative w-full scroll-mt-16 bg-gray-25 px-5 py-20 xl:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <span
      data-reveal
      class="flex h-8 items-center gap-1.5 rounded-9 bg-gray-0 pl-2 pr-3 text-label-sm text-gray-700 shadow-button-white"
    >
      <RiPriceTag3Line className="size-4 text-gray-400" />
      Precios
    </span>

    <h2 data-reveal style="--reveal-delay: 60ms" class="mt-4 text-balance text-center text-title-h4 text-gray-900 xl:text-title-h3">
      Todo incluido, sin sorpresas.
    </h2>
    <p data-reveal style="--reveal-delay: 120ms" class="mt-3 max-w-xl text-pretty text-center text-paragraph-md text-gray-600">
      Pagas por <span class="text-label-md text-gray-900">sucursal</span> y la
      <span class="text-label-md text-gray-900">IA va incluida</span> en todos los planes. Sin
      permanencia y sin costos ocultos.
    </p>

    <!-- `xl:mt-28` y no `mt-16`: encima del conmutador va la nota manuscrita,
         que mide unos 80 px de alto y cuelga hacia arriba. Con menos aire se
         montaba sobre el párrafo y se leían las dos cosas cruzadas. -->
    <div data-reveal style="--reveal-delay: 180ms" class="mt-12 w-full xl:mt-32">
      <PricingTable client:visible />
    </div>

    <!-- La nota de abajo, como la de alignui: lo que no cabe en la tabla pero
         cambia la decisión de quien está mirando el precio. -->
    <div
      data-reveal
      class="mt-3 flex w-full items-start gap-3 rounded-[18px] bg-gray-0 p-5 ring-1 ring-gray-200"
    >
      <span class="flex size-8 shrink-0 items-center justify-center rounded-9 bg-gray-25 text-gray-500">
        <RiInformationLine className="size-[18px]" />
      </span>
      <div>
        <div class="text-label-sm text-gray-900">¿Varias sucursales o un caso raro?</div>
        <p class="mt-0.5 text-pretty text-paragraph-sm text-gray-600">
          A partir de cinco locales el precio por sucursal baja. Escríbenos a
          <a href="mailto:hola@amunpos.com" class="text-primary-base underline underline-offset-2">hola@amunpos.com</a>
          y lo armamos contigo.
        </p>
      </div>
    </div>
  </div>
</section>
