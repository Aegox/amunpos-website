---
import { RiCheckLine } from "@remixicon/react";

const plans = [
  {
    title: "Básico",
    target: "Para pequeños negocios",
    price: "$24",
    popular: false,
    features: ["Hasta 1 usuario", "Gestión de inventario", "Informes y análisis de ventas", "Asistente IA incluido", "Soporte 24/7"],
  },
  {
    title: "Estándar",
    target: "Para profesionales",
    price: "$50",
    popular: true,
    features: ["Hasta 3 usuarios", "Inventario multi-sucursal", "Migración y facturación con IA", "Informes y análisis de ventas", "Soporte 24/7 prioritario"],
  },
  {
    title: "Profesional",
    target: "Para grandes empresas",
    price: "$85",
    popular: false,
    features: ["Usuarios ilimitados", "Inventario multi-sucursal", "Todas las funciones de IA", "Informes y análisis avanzados", "Soporte 24/7 dedicado"],
  },
];
---

<section id="Planes" class="relative w-full scroll-mt-16 bg-gray-25 px-5 py-20 xl:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <h2 class="max-w-xl text-pretty text-center text-title-h4 text-gray-900 xl:text-title-h3">
      Planes transparentes, la IA incluida en todos
    </h2>
    <p class="mt-3 max-w-lg text-center text-paragraph-md text-gray-600">
      Sin costos ocultos ni complementos sorpresa: elige según el tamaño de tu equipo.
    </p>

    <div class="mt-14 flex w-full flex-col items-center gap-6 xl:flex-row xl:items-stretch">
      {plans.map((plan) => (
        <article class="flex w-full flex-col rounded-18 border border-gray-200 bg-gray-0 p-7 md:w-[80%] xl:w-1/3">
          <div class="flex items-center justify-between">
            <h3 class="text-title-h6 text-gray-900">{plan.title}</h3>
            {plan.popular && <span class="rounded-full bg-primary-alpha-10 px-2.5 py-1 text-label-xs text-primary-dark">Popular</span>}
          </div>
          <p class="mt-1 text-paragraph-sm text-gray-600">{plan.target}</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-title-h4 text-gray-900">{plan.price}</span>
            <span class="text-paragraph-sm text-gray-600">/ mes</span>
          </div>

          <a
            href="#Contacto"
            class={`mt-6 flex h-11 w-full items-center justify-center rounded-13 text-label-sm transition duration-200 ${
              plan.popular ? "bg-primary-base text-gray-0 shadow-button-gray hover:bg-primary-dark" : "border border-gray-200 text-gray-900 hover:bg-gray-50"
            }`}
          >
            Escoger plan
          </a>

          <div class="my-6 h-px w-full bg-gray-200"></div>

          <ul class="flex flex-col gap-3">
            {plan.features.map((item) => (
              <li class="flex items-center gap-2.5 text-paragraph-sm text-gray-700">
                <RiCheckLine className="size-4 shrink-0 text-primary-base" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
