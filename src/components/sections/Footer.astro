---
import { RiFacebookFill, RiTwitterXFill, RiLinkedinFill, RiInstagramLine } from "@remixicon/react";

const productLinks = [
  { label: "Características", id: "Caracteristicas" },
  { label: "Inteligencia artificial", id: "IA" },
  { label: "Precios", id: "Planes" },
];
const resourceLinks = [
  { label: "Testimonios", id: "Testimonios" },
  { label: "Preguntas frecuentes", id: "Faq" },
  { label: "Contacto", id: "Contacto" },
];
const socials = [
  { href: "https://www.facebook.com/", label: "Facebook", Icon: RiFacebookFill },
  { href: "https://twitter.com/", label: "Twitter", Icon: RiTwitterXFill },
  { href: "https://www.linkedin.com/", label: "LinkedIn", Icon: RiLinkedinFill },
  { href: "https://www.instagram.com/", label: "Instagram", Icon: RiInstagramLine },
];
---

<footer class="w-full border-t border-stroke-soft-200 bg-weak-50 px-5 pt-16">
  <div class="mx-auto grid w-full max-w-[1240px] grid-cols-1 gap-12 pb-12 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.2fr]">
    <div>
      <img src="/logo.svg" alt="AmunPOS" class="mb-5 h-8 w-auto" />
      <p class="max-w-xs text-paragraph-sm text-sub-600">
        AmunPOS une ventas, inventario y equipo en un solo panel, con inteligencia artificial
        que se encarga del trabajo repetitivo para que tu negocio crezca más rápido.
      </p>
    </div>

    <nav>
      <h3 class="mb-4 text-label-sm text-strong-950">Producto</h3>
      <ul class="flex flex-col gap-3">
        {productLinks.map(({ label, id }) => (
          <li>
            <a href={`#${id}`} class="text-paragraph-sm text-sub-600 transition-colors duration-200 hover:text-primary-base">{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav>
      <h3 class="mb-4 text-label-sm text-strong-950">Recursos</h3>
      <ul class="flex flex-col gap-3">
        {resourceLinks.map(({ label, id }) => (
          <li>
            <a href={`#${id}`} class="text-paragraph-sm text-sub-600 transition-colors duration-200 hover:text-primary-base">{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h3 class="mb-4 text-label-sm text-strong-950">Síguenos</h3>
      <div class="flex gap-3">
        {socials.map(({ href, label, Icon }) => (
          <a
            href={href}
            aria-label={label}
            target="_blank"
            rel="noreferrer"
            class="flex size-9 items-center justify-center rounded-full border border-stroke-soft-200 text-sub-600 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-base hover:text-primary-base"
          >
            <Icon size={15} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-stroke-soft-200 py-6">
    <p class="text-center text-paragraph-sm text-soft-400">
      © {new Date().getFullYear()} AmunPOS. Todos los derechos reservados.
    </p>
  </div>
</footer>
