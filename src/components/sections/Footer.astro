---
import {
  RiFacebookFill,
  RiTwitterXFill,
  RiLinkedinFill,
  RiInstagramLine,
  RiArrowRightSLine,
  RiBookOpenLine,
  RiMailLine,
  RiCheckboxCircleFill,
} from "@remixicon/react";

// Lo que se lleva quien deja el correo, dicho en concreto. "Novedades" a secas
// no convence a nadie: el que duda quiere saber cada cuánto le vas a escribir y
// de qué.
const promesas = ["Novedades del producto", "Trucos para tu negocio", "Acceso anticipado a lo nuevo"];

/**
 * Pie calcado del de alignui.com: logo centrado, la frase de la empresa
 * partida en dos líneas —la segunda apagada—, los iconos sociales debajo, y
 * las columnas de enlaces separadas por rayas VERTICALES con un puntito
 * cuadrado en cada extremo. Ese puntito es lo que hace que la retícula se lea
 * como un plano y no como una tabla; sin él las rayas parecen bordes sueltos.
 *
 * Tres columnas y no cinco como ellos: el sitio es de una sola página, así que
 * todos los enlaces son anclas. Inventar columnas obligaría a repetir el mismo
 * destino varias veces, que es peor que tener menos.
 */
const columnas = [
  {
    titulo: "Producto",
    enlaces: [
      { label: "Qué hay dentro", href: "#Producto" },
      { label: "Planes", href: "#Planes" },
      { label: "Preguntas frecuentes", href: "#Faq" },
    ],
  },
  {
    titulo: "Empresa",
    enlaces: [
      { label: "Nosotros", href: "#Inicio" },
      { label: "Beneficios", href: "#Testimonios" },
      { label: "Contacto", href: "#Contacto" },
    ],
  },
  {
    titulo: "Empezar",
    enlaces: [
      { label: "Crear cuenta", href: "#Planes" },
      { label: "Iniciar sesión", href: "#" },
    ],
  },
];

const socials = [
  { href: "https://www.facebook.com/", label: "Facebook", Icon: RiFacebookFill },
  { href: "https://twitter.com/", label: "Twitter", Icon: RiTwitterXFill },
  { href: "https://www.linkedin.com/", label: "LinkedIn", Icon: RiLinkedinFill },
  { href: "https://www.instagram.com/", label: "Instagram", Icon: RiInstagramLine },
];
---

<section id="Contacto" class="relative w-full scroll-mt-16 px-5 pb-16 pt-4 xl:pb-24">
  <!-- El conector que baja de la sección anterior y entra en el boletín, el
       mismo recurso que enhebra las secciones en alignui.com. -->
  <svg
    aria-hidden="true"
    viewBox="0 0 1004 48"
    preserveAspectRatio="none"
    class="mx-auto hidden h-12 w-full max-w-[780px] xl:block"
    fill="none"
  >
    <path d="M2 0v8c0 8.84 7.16 16 16 16h468c8.84 0 16 7.16 16 16v8" class="stroke-gray-200" stroke-width="1" vector-effect="non-scaling-stroke"></path>
    <path d="M502 0v18" class="stroke-gray-200" stroke-width="1" vector-effect="non-scaling-stroke"></path>
    <path d="M1002 0v8c0 8.84-7.16 16-16 16H518c-8.84 0-16 7.16-16 16v8" class="stroke-gray-200" stroke-width="1" vector-effect="non-scaling-stroke"></path>
  </svg>

  <!-- El contenedor va a 720 y el texto se estrecha a 560 por dentro: así los
       tres visto-buenos caben en una sola fila, que es donde se leen de un
       golpe. Con todo a 560 el tercero se caía a una segunda línea y parecían
       dos grupos. -->
  <div class="mx-auto flex w-full max-w-[720px] flex-col items-center pt-10 text-center [&>h2]:max-w-[560px] [&>p]:max-w-[560px]">
    <span data-reveal class="flex h-8 items-center gap-1.5 rounded-9 bg-gray-0 pl-2 pr-3 text-label-sm text-gray-700 shadow-button-white">
      <RiBookOpenLine className="size-4 text-gray-400" />
      Mantente al día
    </span>

    <h2 data-reveal style="--reveal-delay: 60ms" class="mt-4 text-balance text-title-h4 text-gray-900">
      Suscríbete a nuestro boletín
    </h2>
    <p data-reveal style="--reveal-delay: 120ms" class="mt-3 text-pretty text-paragraph-md text-gray-600">
      Te contamos lo nuevo de AmunPOS y lo que estamos aprendiendo de otros
      negocios como el tuyo. Sin spam.
    </p>

    <!-- El botón va DENTRO del campo, no al lado: así el conjunto se lee como
         una sola pieza y no como un formulario de dos trozos. El `pr-12` del
         input reserva el sitio para que el texto largo no pase por debajo. -->
    <form data-reveal style="--reveal-delay: 180ms" class="group relative mt-7 w-full max-w-[420px]">
      <label for="correo" class="sr-only">Tu correo electrónico</label>
      <RiMailLine className="pointer-events-none absolute left-3.5 top-1/2 size-[18px] -translate-y-1/2 text-gray-400" />
      <input
        id="correo"
        type="email"
        required
        placeholder="Escribe tu correo…"
        class="h-12 w-full rounded-13 bg-gray-0 pl-11 pr-12 text-paragraph-sm text-gray-900 shadow-button-white outline-none transition placeholder:text-gray-450 focus:ring-2 focus:ring-primary-alpha-16"
      />
      <button
        type="submit"
        aria-label="Suscribirse"
        class="absolute right-1.5 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-9 bg-gray-0 text-gray-500 shadow-badge-gray transition duration-200 hover:bg-gray-50 hover:text-gray-900"
      >
        <RiArrowRightSLine className="size-4" />
      </button>
    </form>
    <p class="mt-3 text-paragraph-xs text-gray-450">Respetamos tu privacidad.</p>

    <ul data-reveal style="--reveal-delay: 240ms" class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {
        promesas.map((texto) => (
          <li class="flex items-center gap-1.5 text-paragraph-sm text-gray-600">
            <RiCheckboxCircleFill className="size-[18px] shrink-0 text-success-base" />
            {texto}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="w-full px-5 pb-8">
  <div class="mx-auto w-full max-w-[1240px]">
    <!-- Regla superior. El puntito va CENTRADO sobre el extremo de la raya
         (de ahí los -translate de media unidad), no pegado al lado. -->
    <div class="relative h-px bg-gray-200">
      <span class="absolute -left-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
      <span class="absolute -right-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
    </div>

    <!-- Bloque de marca -->
    <div class="flex flex-col items-center px-5 py-12 xl:py-14">
      <img src="/logo.png" alt="AmunPOS" class="h-7 w-auto" />
      <p class="mt-5 text-balance text-center text-title-h6 text-gray-900 md:text-title-h5">
        El sistema operativo del comercio
        <span class="block text-gray-450">en Latinoamérica.</span>
      </p>
      <div class="mt-6 flex gap-2">
        {
          socials.map(({ href, label, Icon }) => (
            <a
              href={href}
              aria-label={label}
              target="_blank"
              rel="noreferrer"
              class="flex size-9 items-center justify-center rounded-9 bg-gray-0 text-gray-400 shadow-button-white transition duration-200 hover:bg-gray-25 hover:text-gray-700"
            >
              <Icon size={16} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="relative h-px bg-gray-200">
      <span class="absolute -left-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
      <span class="absolute -right-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
    </div>

    <!-- Columnas. Las rayas verticales van en el hueco ENTRE columnas, no como
         borde de cada una: con `border-l` la primera columna se queda coja y
         las rayas caen pegadas al texto en vez de a media calle. -->
    <div class="relative grid grid-cols-2 gap-x-8 gap-y-10 px-5 py-10 md:grid-cols-3 md:gap-x-10 xl:py-12">
      {
        columnas.map((c, i) => (
          <div class="relative">
            {i > 0 && (
              <span class="absolute -left-4 top-0 hidden h-full w-px bg-gray-200 md:-left-5 md:block">
                <span class="absolute -left-0.5 -top-px size-[5px] border border-gray-300 bg-gray-0" />
                <span class="absolute -bottom-px -left-0.5 size-[5px] border border-gray-300 bg-gray-0" />
              </span>
            )}
            <div class="text-label-sm text-gray-900">{c.titulo}</div>
            <ul class="mt-4 flex flex-col gap-2.5">
              {c.enlaces.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-paragraph-sm text-gray-500 transition-colors duration-200 hover:text-gray-900">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="relative h-px bg-gray-200">
      <span class="absolute -left-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
      <span class="absolute -right-px top-1/2 size-[5px] -translate-y-1/2 border border-gray-300 bg-gray-0"></span>
    </div>

    <p class="py-7 text-center text-paragraph-sm text-gray-450">
      © {new Date().getFullYear()} AmunPOS. Todos los derechos reservados.
    </p>
  </div>
</footer>
