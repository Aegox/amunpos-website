---
import { RiStackLine, RiMoneyDollarCircleLine, RiLineChartLine } from "@remixicon/react";

const outcomes = [
  {
    icon: RiStackLine,
    title: "Todo en un solo lugar",
    text: "Deja de saltar entre POS, Excel, WhatsApp y apps de delivery. Un solo sistema para vender, controlar y hacer crecer tu negocio.",
  },
  {
    icon: RiMoneyDollarCircleLine,
    title: "Menos comisiones, más margen",
    text: "Delivery con app de repartidor propia y módulos incluidos: te quedas con lo que otras herramientas se llevan en comisiones.",
  },
  {
    icon: RiLineChartLine,
    title: "Decisiones con datos, no a ojo",
    text: "Reportes de utilidad y un asistente con IA que te dice, en tiempo real, dónde ganas y dónde pierdes.",
  },
];
---

<section id="Testimonios" class="w-full px-5 py-20 xl:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <h2 class="text-pretty text-center text-title-h4 text-gray-900 xl:text-title-h3">
      Lo que tu negocio va a lograr
    </h2>
    <p class="mt-3 max-w-lg text-center text-paragraph-md text-gray-600">
      No es solo un punto de venta: es la plataforma que ordena y hace crecer tu comercio.
    </p>

    <div class="mt-14 grid w-full grid-cols-1 gap-5 md:grid-cols-3">
      {outcomes.map((o) => {
        const Icon = o.icon;
        return (
          <article class="flex flex-col rounded-18 border border-gray-200 bg-gray-0 p-7">
            <div class="flex size-11 items-center justify-center rounded-[10px] bg-primary-alpha-10">
              <Icon className="size-5 text-primary-base" />
            </div>
            <h3 class="mt-5 text-title-h6 text-gray-900">{o.title}</h3>
            <p class="mt-2 text-paragraph-sm text-gray-700">{o.text}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
