---
import { RiStackLine, RiMoneyDollarCircleLine, RiLineChartLine } from "@remixicon/react";
import Regla from "./Regla.astro";

const outcomes = [
  {
    icon: RiStackLine,
    title: "Todo en un solo lugar",
    text: "Deja de saltar entre POS, Excel, WhatsApp y apps de delivery. Un solo sistema para vender, controlar y hacer crecer tu negocio.",
  },
  {
    icon: RiMoneyDollarCircleLine,
    title: "Menos comisiones, más margen",
    text: "Delivery con app de repartidor propia y módulos incluidos: te quedas con lo que otras herramientas se llevan en comisiones.",
  },
  {
    icon: RiLineChartLine,
    title: "Decisiones con datos, no a ojo",
    text: "Reportes de utilidad y un asistente con IA que te dice, en tiempo real, dónde ganas y dónde pierdes.",
  },
];
---

<section id="Testimonios" class="w-full py-20 xl:py-28">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col items-center px-5">
    <h2 data-reveal class="text-pretty text-center text-title-h4 text-gray-900 xl:text-title-h3">
      Lo que tu negocio va a lograr
    </h2>
    <p data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-lg text-center text-paragraph-md text-gray-600">
      No es solo un punto de venta: es la plataforma que ordena y hace crecer tu comercio.
    </p>
  </div>

  <!-- Esto eran tres tarjetas con borde, sombra y esquinas redondeadas, y se
       salía del lenguaje del resto del sitio: aquí NADA está encerrado en una
       caja. Todo se separa con rayas finas, remates cuadrados y los raíles que
       recorren la página — así están la sección oscura, el pie, el selector y
       las preguntas. Tres tarjetas flotando encima de esa retícula se leían
       como un trozo pegado de otra web.

       Lo mismo sin caja: una raya arriba y otra abajo, y dos verticales
       separando las columnas. Se gana además que las tres se lean como partes
       de una misma idea en vez de como tres objetos sueltos. -->
  <Regla class="mt-14" />

  <div class="mx-auto grid w-full max-w-[1240px] grid-cols-1 px-5 md:grid-cols-3">
    {
      outcomes.map((o, i) => {
        const Icon = o.icon;
        return (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`} class="relative flex flex-col py-8 md:px-8 md:py-10">
            {i > 0 && (
              <span aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-px bg-gray-200 md:block" />
            )}
            <Icon className="size-6 shrink-0 text-primary-base" />
            <h3 class="mt-5 text-label-lg text-gray-900">{o.title}</h3>
            <p class="mt-2 max-w-[42ch] text-pretty text-paragraph-sm text-gray-600">{o.text}</p>
          </div>
        );
      })
    }
  </div>

  <Regla />
</section>
