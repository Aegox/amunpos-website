---
import { RiHeadphoneLine, RiWhatsappLine, RiBookOpenLine, RiGroupLine } from "@remixicon/react";

const items = [
  {
    icon: RiWhatsappLine,
    title: "WhatsApp",
    desc: "Soporte 24/7 para resolver dudas al instante, sin tickets ni esperas.",
  },
  {
    icon: RiBookOpenLine,
    title: "Centro de ayuda",
    desc: "Guías paso a paso y respuestas a las preguntas más comunes.",
  },
  {
    icon: RiGroupLine,
    title: "Comunidad de negocios",
    desc: "Comparte tips y aprende junto a otros dueños de negocio.",
  },
];
---

<section id="Soporte" class="w-full scroll-mt-16 px-5 py-20 xl:py-28">
  <div class="mx-auto flex max-w-[1240px] flex-col items-center">
    <div class="flex h-7 items-center gap-1.5 rounded-9 bg-gray-0 pl-1.5 pr-2.5 text-label-sm text-gray-700 shadow-badge-gray xl:h-8 xl:pl-2 xl:pr-3">
      <RiHeadphoneLine className="size-4 text-gray-400" />
      Soporte
    </div>
    <h4 class="mt-4 text-center text-[28px]/[36px] font-550 -tracking-[0.02em] text-gray-900 md:text-title-h4 xl:text-[48px]/[56px] xl:-tracking-[0.028em]">
      Siempre hay alguien para ayudarte
    </h4>
    <p class="mt-2 max-w-lg text-center text-paragraph-md text-gray-600 xl:mt-3 xl:text-paragraph-lg">
      Soporte real cuando lo necesitas: chat directo, guías claras y una comunidad para crecer acompañado.
    </p>

    <div class="mt-6 flex w-full flex-col flex-wrap justify-center gap-3 md:flex-row md:gap-6 xl:mt-12">
      {
        items.map(({ icon: Icon, title, desc }) => (
          <div class="flex w-full items-center gap-4 rounded-2xl bg-gray-0 px-4 py-3 shadow-button-white md:w-[calc(50%-12px)] md:flex-col md:p-7 md:text-center xl:w-[368px] xl:gap-6 xl:rounded-3xl xl:p-8">
            <Icon className="size-8 shrink-0 text-gray-300 md:size-12 xl:size-16" />
            <div class="space-y-1 xl:space-y-2">
              <div class="text-label-sm text-gray-900 md:text-label-lg">{title}</div>
              <p class="text-pretty text-paragraph-xs text-gray-600 md:text-paragraph-sm">{desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
