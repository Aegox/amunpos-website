---
import { RiWallet3Line, RiStackLine, RiGitBranchLine, RiTeamLine, RiTruckLine, RiLineChartLine, RiCpuLine } from "@remixicon/react";

const items = [
  { icon: RiWallet3Line, title: "Ventas y caja", desc: "Cobra con múltiples métodos de pago y tickets claros en segundos." },
  { icon: RiStackLine, title: "Inventario en tiempo real", desc: "Stock por sucursal con alertas antes de que algo se agote." },
  { icon: RiGitBranchLine, title: "Multi-sucursal", desc: "Compara ventas y equipo entre locales sin hojas de cálculo." },
  { icon: RiTeamLine, title: "Nómina y equipo", desc: "Fichaje, horarios con IA y pagos por país." },
  { icon: RiTruckLine, title: "Delivery propio", desc: "App de repartidor con estados de pedido en vivo." },
  { icon: RiLineChartLine, title: "Reportes claros", desc: "Cifras del negocio explicadas en lenguaje simple." },
];
---

<!-- La sección oscura NO va a sangre. En alignui.com es un panel redondeado
     metido dentro de la página, con su borde, y se lee como una PIEZA — algo
     que puedes señalar — en vez de como un tramo de la página que se puso
     negro. A sangre, además, el negro toca los bordes de la pantalla y pesa el
     doble de lo que debería. -->
<section class="w-full px-5 py-6 xl:py-10">
  <div class="relative z-10 mx-auto w-full max-w-[1360px] overflow-hidden rounded-[28px] bg-gray-950 px-5 py-20 ring-1 ring-inset ring-white/10 xl:rounded-[36px] xl:py-28">
    <div class="pointer-events-none absolute -top-32 left-1/2 h-[420px] w-[640px] -translate-x-1/2 rounded-full bg-primary-base/15 blur-[130px]"></div>

    <!-- Marco decorativo: líneas de borde + "spark" azul cayendo, igual al
         recurso real de alignui.com sobre su sección oscura "Core Features"
         (ahí es naranja; aquí en azul de marca) -->
    <div class="pointer-events-none absolute inset-x-0 top-0 hidden h-full justify-center overflow-hidden lg:flex">
      <div class="relative h-full w-full max-w-[1240px]">
        <div class="absolute inset-y-0 left-0 w-px bg-linear-to-b from-transparent via-white/[.08] to-transparent"></div>
        <div class="absolute inset-y-0 right-0 w-px bg-linear-to-b from-transparent via-white/[.08] to-transparent"></div>
        <span class="spark-line left-0" style="animation-delay: 1.4s;"></span>
        <span class="spark-line right-0"></span>
      </div>
    </div>

    <div class="relative mx-auto flex w-full max-w-[1240px] flex-col items-center">
    <div class="flex h-7 items-center gap-1.5 rounded-9 bg-white/[.03] pl-1.5 pr-2.5 text-label-sm text-gray-300 xl:h-8 xl:pl-2 xl:pr-3" style="box-shadow:0 0 0 1px rgba(0,0,0,.08), inset 0 1px 2px rgba(255,255,255,.12)">
      <RiCpuLine className="size-4 text-gray-500" />
      Funciones principales
    </div>
    <h2 data-reveal class="mt-4 text-pretty text-center text-title-h4 text-gray-0 xl:text-title-h3">¿Qué hay dentro de AmunPOS?</h2>
    <p data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-xl text-center text-paragraph-md text-gray-500">
      Todo lo que reemplaza: la caja registradora, la hoja de inventario y el grupo de
      WhatsApp de nómina — con IA en cada paso.
    </p>

    <div class="relative mt-12 grid w-full divide-y divide-white/[.08] border-t border-white/[.08] md:mt-16 md:grid-cols-2 md:gap-x-6 md:gap-y-10 md:divide-y-0 md:border-0 xl:grid-cols-3">
      {items.map(({ icon: Icon, title, desc }, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 70}ms`} class="flex gap-3 py-4 md:flex-col md:items-center md:gap-0 md:p-4 md:text-center">
          <Icon className="size-[18px] shrink-0 text-primary-base md:size-6" />
          <div class="md:mt-5">
            <div class="text-label-sm text-gray-0 md:text-label-md">{title}</div>
            <div class="mt-1 max-w-[272px] text-pretty text-paragraph-xs text-gray-500 md:text-paragraph-sm">{desc}</div>
          </div>
        </div>
      ))}

      <!-- Rejilla: las dos verticales que separan las tres columnas y la
           horizontal que separa las dos filas. A partir de `md` el grid apaga
           sus propios `divide-y`/`border-t` y las seis funciones quedaban
           flotando sueltas; estas líneas les devuelven la estructura.

           El desfase de 4px es porque el 33,33% del contenedor NO cae en el
           centro del hueco: con `gap-x-6` la columna mide (100%-48px)/3, así
           que el 33,33% queda 4px a la derecha del centro del primer hueco (y
           el 66,66% otros 4px a la izquierda del segundo). Sin corregirlo las
           dos líneas se ven descentradas de forma distinta cada una. -->
      <div
        class="pointer-events-none absolute inset-y-0 hidden w-px bg-linear-to-b from-transparent via-white/[.08] to-transparent xl:block"
        style="left: calc(33.3333% - 4px)"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 hidden w-px bg-linear-to-b from-transparent via-white/[.08] to-transparent xl:block"
        style="left: calc(66.6667% + 4px)"
      >
      </div>
      <div class="pointer-events-none absolute inset-x-0 top-1/2 hidden h-px bg-linear-to-r from-transparent via-white/[.08] to-transparent xl:block"></div>

      <!-- Un punto en cada cruce, como en la sección oscura de alignui.com. El
           anillo es del color del fondo, así que TAPA el cruce: sin él se ve un
           "+" duro; con él parece que las líneas pasan por detrás del punto. Es
           el detalle que hace que esto se lea como una estructura y no como los
           bordes de una tabla. -->
      <span
        class="pointer-events-none absolute top-1/2 hidden size-[7px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/[.14] ring-[6px] ring-gray-950 xl:block"
        style="left: calc(33.3333% - 4px)"></span>
      <span
        class="pointer-events-none absolute top-1/2 hidden size-[7px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/[.14] ring-[6px] ring-gray-950 xl:block"
        style="left: calc(66.6667% + 4px)"></span>
      </div>
    </div>
  </div>
</section>
