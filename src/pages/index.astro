---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/sections/NavBar";
import Hero from "../components/sections/Hero.astro";
import Highlights from "../components/sections/Highlights.astro";
import AiFlow from "../components/sections/AiFlow";
import WhatsInside from "../components/sections/WhatsInside.astro";
import SectionDivider from "../components/sections/SectionDivider.astro";
import Pricing from "../components/sections/Pricing.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Faq from "../components/sections/Faq.astro";
import Problema from "../components/sections/Problema.astro";
import Integraciones from "../components/sections/Integraciones.astro";
import Cierre from "../components/sections/Cierre.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout>
  <NavBar client:load />
  <Hero />
  <Highlights />
  <!-- El problema DESPUES de ver el producto. Se probaron los dos ordenes: con
       el problema delante, la pagina abre en tono de queja y tarda en ensenar
       nada; detras, el visitante ya ha visto el producto y la lista de trastos
       funciona como "y esto es lo que te quita de encima". -->
  <Problema />
  <!-- Y las integraciones a continuacion, que es cuando aparece la duda de
       "?y lo que ya uso?". -->
  <Integraciones />
  <SectionDivider />
  <AiFlow client:visible />
  <WhatsInside />
  <!-- Aquí NO va separador: el separador es para dar aire entre dos bloques que
       comparten fondo. Entre la sección oscura y Planes (gris) el cambio de
       fondo ya separa de sobra, y meterlo obligaba a abrir una franja blanca
       entre el negro y el gris que se veía como un hueco sin rellenar. -->
  <Pricing />
  <Testimonials />
  <SectionDivider />
  <Faq />
  <!-- Separador también DEBAJO: en alignui.com el bloque de preguntas va
       enmarcado por arriba y por abajo, y es lo que lo separa del pie sin
       necesidad de meterle un fondo distinto. -->
  <SectionDivider />
  <!-- El cierre antes del pie: es lo ultimo que ve todo el que baja del todo. -->
  <Cierre />
  <Footer />
</Layout>
