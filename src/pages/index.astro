---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/sections/NavBar";
import Hero from "../components/sections/Hero.astro";
import Highlights from "../components/sections/Highlights.astro";
import AiFlow from "../components/sections/AiFlow";
import WhatsInside from "../components/sections/WhatsInside.astro";
import SectionDivider from "../components/sections/SectionDivider.astro";
import Pricing from "../components/sections/Pricing.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Faq from "../components/sections/Faq.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout>
  <NavBar client:load />
  <Hero />
  <Highlights />
  <SectionDivider />
  <AiFlow client:visible />
  <WhatsInside />
  <!-- Aquí NO va separador: el separador es para dar aire entre dos bloques que
       comparten fondo. Entre la sección oscura y Planes (gris) el cambio de
       fondo ya separa de sobra, y meterlo obligaba a abrir una franja blanca
       entre el negro y el gris que se veía como un hueco sin rellenar. -->
  <Pricing />
  <Testimonials />
  <SectionDivider />
  <Faq />
  <Footer />
</Layout>
