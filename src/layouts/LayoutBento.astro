---
import "../styles/globals.css";
import "../styles/bento.css";
import "../styles/movimiento.css";

/**
 * Cabecera de la web: título, descripción y lo que Google y las redes leen para armar el
 * resultado (URL canónica, vista previa al compartir, datos estructurados en JSON-LD).
 */
interface Props {
  title?: string;
  description?: string;
  /** Ruta de la página, para la URL canónica ("/" en el inicio). */
  ruta?: string;
  /** Páginas internas o de prueba: que Google no las indexe. */
  noindex?: boolean;
  /** Datos estructurados (schema.org) de la página. */
  jsonld?: Record<string, unknown>[];
}

const SITIO = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.amunpos.com";
const {
  title = "amunpos: caja, inventario y compras en un solo sistema",
  description = "Punto de venta para negocios de comida: caja con arqueo, inventario y un pedido sugerido según lo que vendiste en 30 días. Sin permanencia.",
  ruta = Astro.url.pathname,
  noindex = false,
  jsonld = [],
} = Astro.props;
const canonica = `${SITIO}${ruta}`;
const imagen = `${SITIO}/og-amunpos.png`;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="theme-color" content="#0C78C0" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Vista previa al compartir (WhatsApp, Facebook, LinkedIn, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="amunpos" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="amunpos: el panel del punto de venta con caja, inventario y ventas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script is:inline>
      // Las animaciones se muestran siempre, aunque el sistema pida menos movimiento
      // (decisión de Diego, 2026-11-16). Sin IntersectionObserver, todo queda visible.
      if ("IntersectionObserver" in window) document.documentElement.classList.add("js-revela");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bento">
    <slot />
    <script>
      import "../scripts/movimiento.ts";
    </script>
  </body>
</html>
