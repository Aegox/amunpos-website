---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AmunPOS — El punto de venta que hace el trabajo pesado por ti",
  description = "AmunPOS une ventas, inventario, facturación y nómina en un panel con inteligencia artificial que migra tus datos, lee tus facturas y arma los horarios de tu equipo.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
