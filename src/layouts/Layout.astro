---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AmunPOS — El punto de venta que hace el trabajo pesado por ti",
  description = "AmunPOS une ventas, inventario, facturación y nómina en un panel con inteligencia artificial que migra tus datos, lee tus facturas y arma los horarios de tu equipo.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Activa el scroll-reveal solo si hay JS + IntersectionObserver + motion
         permitido. Corre antes del render para no provocar flash, y garantiza
         que sin JS el contenido siempre sea visible. -->
    <script is:inline>
      if (
        "IntersectionObserver" in window &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("js-reveal");
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />

    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        // Respeta prefers-reduced-motion: no oculta nada, deja todo visible.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );

        const start = () =>
          document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

        if (document.readyState !== "loading") start();
        else document.addEventListener("DOMContentLoaded", start);
      })();
    </script>
  </body>
</html>
